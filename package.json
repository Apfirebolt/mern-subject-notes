{
  "name": "mern-subject-notes",
  "version": "1.0.0",
  "description": "MERN stack application for managing subject notes",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node backend/server",
    "server": "nodemon backend/server",
    "install-client": "cd client && npm install",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "vercel-build": "npm run install-client && npm run build --prefix client"
  },
  "keywords": [],
  "author": "Apfirebolt",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "morgan": "^1.12.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "*",
    "nodemon": "*"
  }
}
